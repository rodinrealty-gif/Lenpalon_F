---
// Иконка из src/icons (Phosphor). Цвет — currentColor. Без label — декоративная (aria-hidden).
import type { IconName } from '../lib/icons';
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon not found: ${name}`);
const inner = raw.replace(/^\s*<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  class:list={['i', className]}
  viewBox="0 0 256 256"
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
