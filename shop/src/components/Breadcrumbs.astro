---
export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Навигационная цепочка" class="crumbs">
  {
    items.map((c, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    font-size: 14px;
    color: var(--muted);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .crumbs a {
    text-decoration: underline;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
</style>
