---
import ProductTile from './ProductTile.astro';
import type { Product } from '../data/products';
interface Props {
  title: string;
  products: Product[];
}
const { title, products } = Astro.props;
---

<section class="rule">
  <div class="wrap inner">
    <h2 class="h2 mb">{title}</h2>
    <div class="snap" role="list">
      {products.map((p) => (
        <ProductTile product={p} variant="rail" />
      ))}
    </div>
  </div>
</section>

<style>
  .rule {
    border-top: 1px solid var(--line);
  }
  .inner {
    padding-top: 96px;
    padding-bottom: 112px;
  }
  .mb {
    margin-bottom: 40px;
  }
  .snap {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 16px;
  }
  .snap > :global(*) {
    flex: 0 0 280px;
    scroll-snap-align: start;
  }
</style>
