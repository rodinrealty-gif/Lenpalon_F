---
import type { HTMLAttributes } from 'astro/types';
type Props = { pressed?: boolean; large?: boolean; class?: string } & Omit<HTMLAttributes<'button'>, 'class'>;
const { pressed = false, large = false, class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={['chip', large && 'chip-lg', className]}
  aria-pressed={pressed ? 'true' : 'false'}
  {...rest}
>
  <slot />
</button>
