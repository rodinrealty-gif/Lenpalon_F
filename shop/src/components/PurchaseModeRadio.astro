---
/** Способ покупки: ARIA radiogroup с roving tabindex и стрелками. */
import Icon from './Icon.astro';

interface Props {
  options: { value: string; title: string; text: string }[];
  selected?: number;
}
const { options, selected = 0 } = Astro.props;
---

<div role="radiogroup" aria-label="Способ покупки" class="modes" data-radiogroup>
  {
    options.map((o, i) => (
      <button
        type="button"
        role="radio"
        class="opt"
        aria-checked={i === selected ? 'true' : 'false'}
        tabindex={i === selected ? 0 : -1}
        data-value={o.value}
      >
        <span class="dot">
          <Icon name="check" size={14} />
        </span>
        <span class="txt">
          <span class="t">{o.title}</span>
          <span class="s">{o.text}</span>
        </span>
      </button>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-radiogroup]').forEach((group) => {
    const radios = Array.from(group.querySelectorAll<HTMLElement>('[role="radio"]'));
    const check = (index: number, focus: boolean) => {
      radios.forEach((r, i) => {
        r.setAttribute('aria-checked', i === index ? 'true' : 'false');
        r.tabIndex = i === index ? 0 : -1;
      });
      if (focus) radios[index]?.focus();
      group.dispatchEvent(new CustomEvent('radiochange', { detail: radios[index]?.dataset.value, bubbles: true }));
    };
    radios.forEach((r, i) => {
      r.addEventListener('click', () => check(i, false));
      r.addEventListener('keydown', (e) => {
        const last = radios.length - 1;
        let next: number | undefined;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = last;
        if (e.key === ' ' || e.key === 'Enter') next = i;
        if (next === undefined) return;
        e.preventDefault();
        check(next, true);
      });
    });
  });
</script>

<style>
  .modes {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .opt {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .opt:hover {
    border-color: var(--ink);
  }
  .opt[aria-checked='true'] {
    border-color: var(--ink);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--ink);
  }
  .dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--on-accent);
  }
  .opt[aria-checked='true'] .dot {
    background: var(--accent);
    border-color: var(--accent);
  }
  .dot :global(.i) {
    display: none;
  }
  .opt[aria-checked='true'] .dot :global(.i) {
    display: inline-block;
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .t {
    font-weight: 600;
    font-size: 16px;
  }
  .s {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
