---
import type { Size } from '../data/products';
interface Props {
  sizes: Size[];
  selected: number;
}
const { sizes, selected } = Astro.props;
---

<div role="group" aria-labelledby="size-label" class="group">
  <span id="size-label" class="label">Упаковка</span>
  <div class="chips">
    {
      sizes.map((s, i) => (
        <button type="button" class="chip chip-lg" aria-pressed={i === selected ? 'true' : 'false'} data-size-index={i}>
          {s.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .label {
    font-size: 15px;
    font-weight: 600;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
