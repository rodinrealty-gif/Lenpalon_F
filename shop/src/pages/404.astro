---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Страница не найдена" noindex>
  <section class="wrap page">
    <div class="box">
      <Icon name="sparkle" size={40} class="muted" />
      <h1 class="title">Страница не найдена</h1>
      <p class="text">Возможно, ссылка устарела. Загляните в каталог или вернитесь на главную.</p>
      <div class="cta">
        <a href="/catalog" class="btn btn-primary">
          Смотреть каталог
        </a>
        <a href="/" class="btn btn-ghost">
          На главную
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    padding-top: 56px;
    padding-bottom: 120px;
  }
  .box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 72px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  .title {
    margin: 0;
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 44ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
