---
import Layout from '../components/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductTile from '../components/ProductTile.astro';
import PromoTile from '../components/PromoTile.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { categories, ALL_LABEL } from '../data/categories';
import { productsCount } from '../lib/plural';

const [a, b, ...rest] = products;
---

<Layout title="Каталог добавок" description="Все добавки по целям: спорт, сон, иммунитет." current="catalog">
  <section class="wrap top">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог' }]} />
    <h1 class="title rise">Все добавки</h1>
    <div class="bar">
      <div role="group" aria-label="Фильтр по цели" class="chips">
        <button type="button" class="chip" aria-pressed="true" data-filter="all">{ALL_LABEL}</button>
        {
          categories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c.slug}>
              {c.label}
            </button>
          ))
        }
      </div>
      <div class="tools">
        <span class="count" aria-live="polite" data-count>{productsCount(products.length)}</span>
        <label for="sort" class="muted">Сортировка</label>
        <select id="sort" class="field sort" data-sort>
          <option value="popular">Популярные</option>
          <option value="asc">Сначала дешевле</option>
          <option value="desc">Сначала дороже</option>
        </select>
      </div>
    </div>
  </section>

  <section class="wrap list">
    <div class="grid" data-grid>
      {a && <ProductTile product={a} variant="catalog" headingLevel={2} index={0} />}
      {b && <ProductTile product={b} variant="catalog" headingLevel={2} index={1} />}
      <PromoTile />
      {rest.map((p, i) => <ProductTile product={p} variant="catalog" headingLevel={2} index={i + 2} />)}
    </div>

    <div class="empty" data-empty hidden>
      <Icon name="sparkle" size={40} class="empty-icon" />
      <h2 class="empty-title">В этой категории пока пусто</h2>
      <p class="empty-text">Загляните в другие цели или посмотрите весь каталог. Новинки появятся здесь первыми.</p>
      <button type="button" class="btn btn-primary" data-reset>Показать все товары</button>
    </div>
  </section>
</Layout>

<script>
  import { productsCount } from '../lib/plural';
  import { isCategory } from '../data/categories';

  type Sort = 'popular' | 'asc' | 'desc';
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
  const promo = grid?.querySelector<HTMLElement>('[data-promo]') ?? null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const tiles = Array.from(grid?.querySelectorAll<HTMLElement>('[data-tile]') ?? []);

  const params = new URLSearchParams(window.location.search);
  const initial = params.get('cat');
  let filter = isCategory(initial) ? initial : 'all';
  let sort: Sort = 'popular';

  const price = (el: HTMLElement) => (el.dataset.price ? Number(el.dataset.price) : null);
  const idx = (el: HTMLElement) => Number(el.dataset.index ?? 0);

  function compare(x: HTMLElement, y: HTMLElement): number {
    if (sort === 'popular') return idx(x) - idx(y);
    const px = price(x);
    const py = price(y);
    // товары без цены — в конце, в исходном порядке
    if (px === null && py === null) return idx(x) - idx(y);
    if (px === null) return 1;
    if (py === null) return -1;
    return sort === 'asc' ? px - py || idx(x) - idx(y) : py - px || idx(x) - idx(y);
  }

  function render() {
    if (!grid || !empty || !count) return;
    const shown = tiles.filter((t) => filter === 'all' || t.dataset.cat === filter).sort(compare);
    const hidden = tiles.filter((t) => !shown.includes(t));
    hidden.forEach((t) => (t.hidden = true));
    shown.forEach((t) => {
      t.hidden = false;
      grid.append(t);
    });
    if (promo) {
      promo.hidden = filter !== 'all' || shown.length === 0;
      const anchor = shown[1];
      if (anchor) anchor.after(promo);
      else grid.append(promo);
    }
    grid.hidden = shown.length === 0;
    empty.hidden = shown.length !== 0;
    count.textContent = productsCount(shown.length);
    chips.forEach((c) => c.setAttribute('aria-pressed', c.dataset.filter === filter ? 'true' : 'false'));
  }

  function setFilter(value: string) {
    filter = value;
    const url = new URL(window.location.href);
    if (value === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', value);
    history.replaceState(null, '', url);
    render();
  }

  chips.forEach((c) => c.addEventListener('click', () => setFilter(c.dataset.filter ?? 'all')));
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    setFilter('all');
    chips[0]?.focus();
  });
  sortSelect?.addEventListener('change', () => {
    sort = sortSelect.value as Sort;
    render();
  });
  render();
</script>

<style>
  .top {
    padding-top: 32px;
  }
  .title {
    margin: 32px 0 40px;
    font-size: clamp(44px, 5.4vw, 76px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .bar {
    border-top: 1px solid var(--ink);
    padding: 20px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    font-size: 15px;
  }
  .count {
    color: var(--muted);
  }
  .sort {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  .list {
    padding-top: 32px;
    padding-bottom: 120px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 56px 24px;
    align-items: start;
  }
  .empty {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 72px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  .empty-icon {
    color: var(--muted);
  }
  .empty-title {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .empty-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 44ch;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
